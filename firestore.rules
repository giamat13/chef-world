rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user (including anonymous/guest accounts) has their
    // own recipes subcollection at /users/{uid}/recipes/{recipeId}.
    // Only that same uid may read or write it. No one — not even other
    // signed-in users — can access another user's recipes.
    match /users/{userId}/recipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Published recipes live at /publicRecipes/{uid}_{recipeId}. Any signed-in
    // user can browse them; only the owner can publish, update or remove
    // their own entries.
    match /publicRecipes/{pubId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && pubId == request.auth.uid + '_' + request.resource.data.sourceId
        // ownerLabel must never leak the uploader's raw email address.
        && !request.resource.data.ownerLabel.matches('.*@.*');
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Reviews: one per user per published recipe, stored at
    // /publicRecipes/{pubId}/reviews/{uid}. Nobody can review their own recipe.
    match /publicRecipes/{pubId}/reviews/{reviewerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == reviewerId
        && request.resource.data.uid == reviewerId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.authorLabel is string
        && !request.resource.data.authorLabel.matches('.*@.*')
        && get(/databases/$(database)/documents/publicRecipes/$(pubId)).data.ownerId != request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == reviewerId;
    }

    // Lets the community grid read every review at once to show average ratings.
    match /{path=**}/reviews/{reviewId} {
      allow read: if request.auth != null;
    }

    // Chefs a user follows: /users/{uid}/following/{chefUid}. Private to the user.
    match /users/{userId}/following/{chefId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && chefId != userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
